{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": "off",
    "react/exhaustive-effect-dependencies": "off"
  },
  "overrides": [
    {
      "files": [
        "src/routes/**",
        "src/features/realtime/realtime-provider.tsx",
        "src/app/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/mocks/**",
        "scripts/**",
        "tests/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "tests/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "playwright-report",
    "test-results",
    "src/routeTree.gen.ts",
    "lighthouse"
  ]
}