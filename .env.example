# Base path of the REST API. With the mocks enabled every call is answered by
# MSW on this same origin.
VITE_API_BASE_URL=/api

# Socket.IO endpoint. The mock transport intercepts this URL; point it at a real
# gateway to run against a live backend.
VITE_SOCKET_URL=https://api.kurio.test

# Turns the whole mock layer (REST + Socket.IO) on or off.
VITE_ENABLE_MOCKS=true

# Seed of the deterministic fixture generator. The same seed always produces the
# same catalogue, prices and availability.
VITE_MOCK_SEED=20260917
